generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum AgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PropertyType {
  HOUSE
  APARTMENT
  BEDSITTER
  SINGLE_ROOM
  AIRBNB
  LAND
}

enum PropertyStatus {
  FOR_SALE
  FOR_RENT
  SHORT_TERM
  SOLD
  RENTED
}

// ----------------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------------

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String
  
  // RBAC Role
  role          Role        @default(CUSTOMER)
  
  // Agent-specific fields
  agencyName    String?
  phoneNumber   String?
  agentStatus   AgentStatus @default(PENDING) // Used by admins to approve/suspend
  isVerified    Boolean     @default(false) // Blue checkmark for anti-scam
  
  // Billing & Subscription
  subscriptionPlan String      @default("FREE_TRIAL") // e.g., FREE_TRIAL, PREMIUM, PRO
  trialEndsAt   DateTime?      // When the free trial expires

  // Password Reset
  resetToken    String?
  resetTokenExpiry DateTime?
  
  // Relationships
  properties    Property[]  @relation("AgentProperties")
  reviews       Review[]    @relation("AgentReviews")
  activityLogs  ActivityLog[] @relation("UserActivities")
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Report {
  id          String   @id @default(uuid())
  reason      String   @db.Text
  propertyId  String
  property    Property @relation("PropertyReports", fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  status      String   @default("PENDING") // PENDING, REVIEWED
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String   // e.g., "PROPERTY_CREATED", "AGENT_VERIFIED"
  details   String   @db.Text
  userId    String?
  user      User?    @relation("UserActivities", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Review {
  id          String   @id @default(uuid())
  customerName String
  rating      Int      @default(5) // 1 to 5
  comment     String   @db.Text
  
  // Link to the agent
  agentId     String
  agent       User     @relation("AgentReviews", fields: [agentId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model Property {
  id            String         @id @default(uuid())
  title         String
  description   String
  location      String
  latitude      Float?
  longitude     Float?
  price         String         
  images        String[]       // Array of URLs for multiple property photos
  categorizedImages Json?      // Categorized photos e.g. { "Exterior": ["url"], "Rooms": ["url"] }
  amenities     String[]       @default([]) // Array of premium amenities
  videoUrl      String?        // YouTube/Vimeo link
  virtualTourUrl String?       // Matterport 3D tour iframe link
  
  type          PropertyType
  status        PropertyStatus @default(FOR_RENT)
  
  beds          Int            @default(0)
  baths         Int            @default(0)
  
  // Analytics
  views         Int            @default(0)
  saves         Int            @default(0)
  
  // Neighborhood Insights
  transitScore  String?
  walkability   String?
  nearbyPlaces  String?
  nearbySchools String?
  nearbyHospitals String?
  
  // Financial & Utilities (Mostly for Rentals)
  deposit       String?        // e.g., "1 Month Rent", "None"
  waterBill     String?        // e.g., "Included", "Separate Meter"
  electricity   String?        // e.g., "Prepaid", "Postpaid", "Included"
  
  // Additional Features
  parking       String?        // e.g., "1 slot included", "Street parking"
  petFriendly   Boolean        @default(false)
  
  // Foreign Key linking to the Agent who posted this
  agentId       String
  agent         User           @relation("AgentProperties", fields: [agentId], references: [id], onDelete: Cascade)
  
  // Inquiries made on this property
  inquiries     Inquiry[]
  
  // Anti-scam reports
  reports       Report[]       @relation("PropertyReports")
  
  isFeatured    Boolean        @default(false)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Inquiry {
  id            String      @id @default(uuid())
  customerName  String
  customerEmail String
  customerPhone String?
  message       String      @db.Text
  
  // Tour Request Fields
  isTourRequest Boolean     @default(false)
  tourDate      DateTime?
  
  // Foreign Key linking to the Property
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime    @default(now())
}

model AlertSubscription {
  id        String   @id @default(uuid())
  email     String
  query     String   // Store search criteria as JSON string
  createdAt DateTime @default(now())
}

model PlatformSettings {
  id                      String   @id @default("singleton")
  supportEmail            String   @default("support@swiftspace.africa")
  supportPhone            String   @default("+254 700 000000")
  siteName                String   @default("SwiftSpaces")
  maintenanceMode         Boolean  @default(false)
  allowAgentRegistration  Boolean  @default(true)
  facebookUrl             String?
  instagramUrl            String?
  twitterUrl              String?
  updatedAt               DateTime @updatedAt
}
